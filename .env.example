# UXer server configuration (copy to .env)

# HTTP port for the Go server
UXER_PORT=8080

# SQLite database file path (relative to the server working directory)
UXER_DB_PATH=data/uxer.db

# Secret used to sign session cookies (use a long random string, e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Set to 1 when serving over HTTPS to mark session cookies Secure
UXER_SECURE_COOKIE=0

# Comma-separated hostnames allowed to bypass the SSRF guard (e.g. local
# development targets): localhost,127.0.0.1
ALLOW_PRIVATE_HOSTS=localhost,127.0.0.1

# Directory of the built frontend, served by the Go server in production
UXER_STATIC_DIR=client/dist
